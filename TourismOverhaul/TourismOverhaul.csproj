<Project Sdk="Microsoft.NET.Sdk">

  <!-- Common properties for all CS2 mod projects on this machine.
       Sets OutputType=Library, TargetFramework=net48, LangVersion=9.0,
       and wires AssemblySearchPaths to Cities2_Data/Managed. -->
  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />

  <PropertyGroup>
    <RootNamespace>TourismOverhaul</RootNamespace>
    <AssemblyName>TourismOverhaul</AssemblyName>
    <Configurations>Debug;Release</Configurations>
    <PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Game">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Core">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Logging">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.IO.AssetDatabase">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Localization">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Mathematics">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.UI.Binding">
      <Private>false</Private>
    </Reference>
    <Reference Include="Colossal.Collections">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Entities">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Collections">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Mathematics">
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Burst">
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

  <!--
    Overrides Mod.targets' DeployWIP, which does:

        <RemoveDir Directories="$(DeployDir)" />
        <Copy SourceFiles="@(FilesToDeploy)" ... />

    Webpack writes this mod's UI bundle ($CSII_USERDATAPATH\Mods\TourismOverhaul\*.mjs and
    *.css) into that same folder, so the RemoveDir silently deletes the frontend every time the
    managed project is built — the UI module then never registers and the panel rows vanish with
    no error anywhere.

    This copy is identical minus the RemoveDir, so managed and UI artifacts coexist. Stale
    managed files are not cleaned up as a result; delete the deploy folder by hand if the
    assembly is ever renamed.

    Mod.targets documents this override mechanism: declare a target with the same name after the
    import.
  -->
  <Target Name="DeployWIP" AfterTargets="AfterBuild" Condition="'$(NeedBuild)'">
    <ItemGroup>
      <FilesToDeploy Include="$(OutDir)\**\*.*" />
    </ItemGroup>
    <Message Text="Copy output to deploy directory $(DeployDir) (preserving UI artifacts)" Importance="high" />
    <Copy SourceFiles="@(FilesToDeploy)" DestinationFiles="@(FilesToDeploy->'$(DeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
